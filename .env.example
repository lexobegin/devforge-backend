# ============================================================
# DevForge AI — Variables de entorno (ejemplo / desarrollo) — CICLO 2
# Copiar a .env y ajustar valores
# Cambios respecto al Ciclo 1:
#   - FUERA: POSTGRES_* y DB_POOL_* (ahora MongoDB)
#   - NUEVO: MONGODB_URI / MONGODB_DB
#   - NUEVO: bloque IA_* (LlmProvider: Ollama principal + respaldos)
#   - NUEVO: bloque VOZ_* (faster-whisper) y VISION_* (boceto → UML completo)
#   - La generación de código sigue produciendo Spring Boot + BD relacional
#     (por eso se conservan GENERATED_BACKEND_*)
# ============================================================

# --- Aplicación ---
APP_NAME=DevForge AI
APP_ENV=development
APP_DEBUG=True
APP_VERSION=0.2.0
API_V1_PREFIX=/api/v1

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000

# --- MongoDB (Ciclo 2) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=devforge_db

# --- JWT ---
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (separado por comas) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_DIAGRAMA=50

# --- IA local (Ciclo 2) — LlmProvider ---
# IA_PROVIDER: ollama | openai_compat | gemini  (principal del Ciclo 2: ollama)
# IA_CADENA_RESPALDO: orden de conmutación si el principal no está disponible
IA_PROVIDER=ollama
IA_CADENA_RESPALDO=openai_compat,gemini
IA_TIMEOUT_SECONDS=120

# Ollama (instalado en la misma máquina que el backend; IA local obligatoria)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_TEXT=qwen2.5:7b            # Agente Dev: edición/revisión/consulta/resumen
OLLAMA_MODEL_LIGERO=llama3.2:3b         # Asistente Guía y tareas cortas
OLLAMA_MODEL_EMBEDDINGS=nomic-embed-text # contexto persistente (similitud coseno)
OLLAMA_TIMEOUT_SECONDS=120

# Respaldo 1: cualquier servidor compatible con la API de OpenAI
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini

# Respaldo 2: Gemini en la nube (A4)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Voz (Ciclo 2, transcripción local) ---
VOZ_ENABLED=True
VOZ_MODELO_WHISPER=base                 # base en desarrollo; small en producción
VOZ_IDIOMA=es

# --- Visión (boceto → UML completo; Ciclo 2 corrige: nombres, atributos y relaciones) ---
VISION_USAR_IA_LOCAL=True               # OpenCV+Tesseract detectan candidatos y el LLM local los interpreta
VISION_MAX_CLASES=30

# --- Generación de código (Capa 2) — los proyectos generados siguen siendo relacionales ---
GENERATED_PROJECTS_DIR=generated_projects
GENERATED_BACKEND_GROUP_ID=com.devforge.generated
GENERATED_BACKEND_ARTIFACT_PREFIX=backend
GENERATED_BACKEND_JAVA_VERSION=17
GENERATED_BACKEND_SPRING_BOOT_VERSION=3.2.5
GENERATED_BACKEND_POSTGRES_VERSION=15

# --- Almacenamiento ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
EXPORT_DIR=exports

# --- Logging ---
LOG_LEVEL=INFO

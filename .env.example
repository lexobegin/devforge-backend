# ============================================================
# DevForge AI — Variables de entorno (ejemplo / desarrollo)
# Copiar a .env y ajustar valores
# ============================================================

# --- Aplicación ---
APP_NAME=DevForge AI
APP_ENV=development
APP_DEBUG=True
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=devforge
POSTGRES_PASSWORD=devforge
POSTGRES_DB=devforge_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

# --- JWT ---
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (separado por comas) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_DIAGRAMA=50

# --- Generación de código (Capa 2) ---
GENERATED_PROJECTS_DIR=generated_projects
GENERATED_BACKEND_GROUP_ID=com.devforge.generated
GENERATED_BACKEND_ARTIFACT_PREFIX=backend
GENERATED_BACKEND_JAVA_VERSION=17
GENERATED_BACKEND_SPRING_BOOT_VERSION=3.2.5
GENERATED_BACKEND_POSTGRES_VERSION=15

# --- IA (modo online) ---
AI_PROVIDER=internal
AI_API_KEY=
AI_MODEL_TEXT=gpt-4o-mini
AI_MODEL_VISION=gpt-4o
AI_TIMEOUT_SECONDS=30

# --- Almacenamiento ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
EXPORT_DIR=exports

# --- Logging ---
LOG_LEVEL=INFO
# ============================================================
# DevForge AI — Variables de entorno (PRODUCCIÓN) — CICLO 2
# Subdominio: api-devforgeai.duckdns.org
# Servidor: Google Cloud Compute Engine (Ubuntu Server 24.04 LTS) + Nginx
# Sin Docker (igual que el Ciclo 1): Gunicorn + UvicornWorker detrás de Nginx
# ============================================================

# --- Aplicación ---
APP_NAME=DevForge AI
APP_ENV=production
APP_DEBUG=False
APP_VERSION=0.2.0
API_V1_PREFIX=/api/v1

# --- Servidor (Gunicorn + UvicornWorker detrás de Nginx) ---
HOST=127.0.0.1
PORT=8000
BACKEND_PUBLIC_URL=https://api-devforgeai.duckdns.org

# --- MongoDB (Ciclo 2; instalado en la misma VM) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=devforge_prod_db

# --- JWT (generar con: openssl rand -hex 64) ---
JWT_SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_DE_64_BYTES_HEX
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (solo dominios reales de producción) ---
CORS_ORIGINS=https://devforgeai.vercel.app,https://api-devforgeai.duckdns.org
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS_PER_DIAGRAMA=100

# --- IA local (Ciclo 2) — Ollama en la misma VM ---
IA_PROVIDER=ollama
IA_CADENA_RESPALDO=openai_compat,gemini
IA_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_TEXT=qwen2.5:7b
OLLAMA_MODEL_LIGERO=llama3.2:3b
OLLAMA_MODEL_EMBEDDINGS=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Voz (transcripción local; modelo más preciso en producción) ---
VOZ_ENABLED=True
VOZ_MODELO_WHISPER=small
VOZ_IDIOMA=es

# --- Visión (boceto → UML completo) ---
VISION_USAR_IA_LOCAL=True
VISION_MAX_CLASES=30

# --- Generación de código (Capa 2) — proyectos generados = Spring Boot + PostgreSQL ---
GENERATED_PROJECTS_DIR=/var/devforge/generated_projects
GENERATED_BACKEND_GROUP_ID=com.devforge.generated
GENERATED_BACKEND_ARTIFACT_PREFIX=backend
GENERATED_BACKEND_JAVA_VERSION=17
GENERATED_BACKEND_SPRING_BOOT_VERSION=3.2.5
GENERATED_BACKEND_POSTGRES_VERSION=15

# --- Almacenamiento ---
UPLOAD_DIR=/var/devforge/uploads
MAX_UPLOAD_SIZE_MB=20
EXPORT_DIR=/var/devforge/exports

# --- Logging ---
LOG_LEVEL=INFO
